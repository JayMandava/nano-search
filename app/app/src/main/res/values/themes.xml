<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Transparent window over the system wallpaper: this is a home screen. -->
    <style name="Theme.Home" parent="android:Theme.Material.Wallpaper.NoTitleBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
    </style>
    <!-- The Settings screens are Compose; this only sets the window behind them. -->
    <style name="Theme.Settings" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
