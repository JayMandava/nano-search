<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Device-search launcher: app discovery, icon packs and labels/icons for arbitrary
         notification packages need broad visibility. Reassess before Play distribution. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Read the Wi-Fi radio state for the Settings Active Frame; never changes networking. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Retained for explicitly provisioned privileged/system launcher builds.
         Normal installs use HomeWidgets' ACTION_APPWIDGET_BIND consent fallback. -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Photos keep their GPS location in EXIF; Android hides it from apps unless this is granted. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Lets the file index see documents and downloads, not just media. Granted by the user in Settings. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Optional: only to pick the weather's city from the phone's approximate location, when the user switches that on. -->

    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <!-- SMS/call search is optional; the launcher also works without telephony. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>

    <!-- Used only for explicitly requested model or curated clock-face downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="${nanoAppLabel}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Home">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="${nanoHomeCategory}" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Feeds the Hub and the icon dots. Does nothing until the user allows it in Settings > Notification access; keeps notifications in memory only. -->
        <service
            android:name=".NotificationHub"
            android:exported="true"
            android:label="Nano Search"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".SetupActivity"
            android:taskAffinity="ai.nanosearch.launcher.settings"
            android:exported="false"
            android:label="Set up Nano Search"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Settings" />

        <activity
            android:name=".AdvancedActivity"
            android:taskAffinity="ai.nanosearch.launcher.settings"
            android:exported="false"
            android:label="Advanced"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Settings" />

        <activity
            android:name=".ClockFacesActivity"
            android:taskAffinity="ai.nanosearch.launcher.settings"
            android:exported="false"
            android:label="Clock Faces"
            android:theme="@style/Theme.Settings" />

        <activity
            android:name=".ModelsActivity"
            android:taskAffinity="ai.nanosearch.launcher.settings"
            android:exported="false"
            android:label="Models"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Settings" />

        <activity
            android:name=".HiddenAppsActivity"
            android:taskAffinity="ai.nanosearch.launcher.settings"
            android:exported="false"
            android:label="Hidden apps"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Settings" />

        <activity
            android:name=".SettingsActivity"
            android:taskAffinity="ai.nanosearch.launcher.settings"
            android:exported="false"
            android:label="Settings"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Settings" />
        <!-- The clocks as a live wallpaper, so they can sit behind the lock screen. -->
        <service
            android:name=".clocks.ClockWallpaperService"
            android:enabled="${nanoWallpaperEnabled}"
            android:exported="true"
            android:label="Nano Clock"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/clock_wallpaper" />
        </service>
    </application>
</manifest>
